<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for AppSecrets.plist: the keys that ship in the app.

  Copy this file to `AppSecrets.plist` (same folder) and fill it in.
  AppSecrets.plist is gitignored, so these stay out of this public repo — not
  because they're secret (both are made to ship in clients) but so other
  people's builds don't run on, or report into, this project.

  The TMDB token is NOT here: it lives in TMDBSecrets.plist, for development
  only, and never ships.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The service's publishable key (sb_publishable_…). Present → TMDB requests
	     go through the service's proxy. Absent → straight to TMDB with the token
	     in TMDBSecrets.plist, or the built-in demo data without one. -->
	<key>ServiceKey</key>
	<string></string>
	<!-- Optional: PostHog project token (phc_…). Absent → analytics is off. -->
	<key>PostHogProjectToken</key>
	<string></string>
</dict>
</plist>
