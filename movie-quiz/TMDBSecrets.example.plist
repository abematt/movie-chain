<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for TMDBSecrets.plist.

  Copy this file to `TMDBSecrets.plist` (same folder) and paste your own token.
  TMDBSecrets.plist is gitignored, so your credential stays out of source
  control. It's for development: Release builds leave the file out, and the app
  reaches TMDB through the service's proxy (ServiceKey in AppSecrets.plist).
  With neither, the app falls back to the built-in demo data.

  Get a token free at https://www.themoviedb.org/settings/api
    - v4 Read Access Token (recommended): set UsesBearerToken = true
    - v3 API key:                          set UsesBearerToken = false
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>TMDBToken</key>
	<string>PASTE_YOUR_TMDB_TOKEN_HERE</string>
	<key>UsesBearerToken</key>
	<true/>
</dict>
</plist>
